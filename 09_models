##Candidate polinomial models

### 84 DAS

models_poly_84 <- list(
  m84_ps1 = "yiel_dmean ~ poly(osavi, 2, raw = TRUE) + ndvi +  evi + seed_rate",
  m84_ps2 = "yiel_dmean ~ poly(osavi, 2, raw = TRUE) + ndvi + seed_rate",
  m84_ps3 = "yiel_dmean ~ poly(osavi, 2, raw = TRUE) + evi +  seed_rate",
  m84_ps4 = "yiel_dmean ~ poly(osavi, 2, raw = TRUE) + ndvi ",
  m84_ps5 = "yiel_dmean ~ poly(osavi, 2, raw = TRUE) + ndvi + evi",
  m84_ps6 = "yiel_dmean ~ poly(osavi, 2, raw = TRUE) + seed_rate",
  m84_ps7 = "yiel_dmean ~ poly(osavi, 2, raw = TRUE) + evi"
)

#combinations
vars <- c("osavi", "ndvi", "evi", "seed_rate")

get_terms <- function(var) {
  c(
    NA,
    var,
    paste0("poly(", var, ", 2, raw = TRUE)"),
    paste0(var, " + poly(", var, ", 2, raw = TRUE)")
  )
}

all_combinations <- expand.grid(lapply(vars, get_terms), stringsAsFactors = FALSE)

formulas <- c()

for (i in 1:nrow(all_combinations)) {
  
  terms <- unlist(all_combinations[i, ])
  terms <- terms[!is.na(terms)]
  
  if (length(terms) > 0) {
    
    # include base variables
    included_vars <- vars[!is.na(unlist(all_combinations[i, ]))]
    
    # condition 1: minimum 2 base variables
    has_two_or_more_vars <- length(included_vars) >= 2
    
    # condition 2: at least one polinomial variable
    has_poly <- any(grepl("poly\\(", terms))
    
    if (has_two_or_more_vars && has_poly) {
      formula <- paste("yiel_dmean ~", paste(terms, collapse = " + "))
      formulas <- c(formulas, formula)
    }
  }
}

names(formulas) <- paste0("m", seq_along(formulas))

length(formulas)
formulas


results_poly_84 <- lapply(
  formulas,
  fit_and_evaluate,
  train_df = train_84,
  test_df = test_84,
  das_label = 84,
  model_type = "Polynomial"
)

metrics_poly_84 <- bind_rows(lapply(results_poly_84, function(x) x$metrics))
metrics_poly_84


