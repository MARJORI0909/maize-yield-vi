
#Format
long_data <- train %>%
  pivot_longer(         #many columns in one column
    cols = all_of(vi_vars),
    names_to = "vi",
    values_to = "value"
  )

# DAS boxplot
# Training plot (116) 
#Simple graphic
p_box <- ggplot(long_data, aes(x = factor(days_after_sowing), y = value)) +
  geom_boxplot(alpha = 0.75, outlier.shape = 16, outlier.size = 1.5) +
  facet_wrap(~ vi, scales = "free_y", ncol = 2) +
  theme_bw(base_size = 11) +
  labs(
    title = "Distribution of vegetative indices by DAS",
    x = "Days after sowing (DAS)",
    y = "Index value"
  ) +
  theme(axis.text.x = element_text(angle = 45, hjust = 1))
  
p_box

