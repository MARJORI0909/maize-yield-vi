#data clean
data <- data_raw %>%
  clean_names() %>%  #standardize names
  rename(
    irrigation = irrigation
  ) %>%
  mutate(
    plot = as.factor(plot),
    point = as.factor(point),
    days_after_sowing = as.numeric(days_after_sowing),
    across(c(evi, gndvi, ndmi, ndvi, osavi, ndre_b05, ndre_b06), as.numeric)
  )

