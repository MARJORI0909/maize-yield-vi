get_corr_matrix_half_labels <- function(df, das_value, vars){
   sub <- df %>%
    filter(days_after_sowing == das_value) %>%
    select(all_of(vars))
 valid_vars <- names(sub)[sapply(sub, function(x){
    sum(!is.na(x)) >= 3 & sd(x, na.rm=TRUE) > 0
  })]

  sub2 <- sub %>% select(all_of(valid_vars))

  cor_mat <- cor(sub2,
                 use = "pairwise.complete.obs",
                 method = "pearson")

  cor_df <- as.data.frame(as.table(cor_mat))
  names(cor_df) <- c("Var1","Var2","Correlation")
  
  cor_df$Var1 <- factor(cor_df$Var1,
                        levels = rownames(cor_mat))

  cor_df$Var2 <- factor(cor_df$Var2,
                        levels = colnames(cor_mat))

  
  cor_df <- cor_df %>%
    mutate(
      i = as.numeric(Var1),
      j = as.numeric(Var2),
      label = ifelse(i >= j, round(Correlation, 2), "")
    )
  
  cor_df$DAS <- das_value

  cor_df
}
         
